# Desktop entry for 工业CT选型速查, generated by `flet build`.
# Desktop environments resolve the app's launcher name and icon from this file
# once it is installed together with the icon theme tree, e.g.:
#   cp -r share/. ~/.local/share/
# then point Exec= at the absolute path of the executable. Exec= cannot ship
# as an absolute path because the bundle is relocatable — its final location
# is only known at install time. On Wayland an installed entry is required for
# the taskbar icon; on X11 the window icon works without it.
[Desktop Entry]
Type=Application
Name=工业CT选型速查
Comment=工业CT工件材质参数预设与选型工具
Exec="工业CT选型速查" %U
Icon=com.flet.ct
Terminal=false
Categories=Utility;
StartupWMClass=com.flet.ct
