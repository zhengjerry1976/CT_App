name: 'ct'
description: '工业CT工件材质参数预设与选型工具'
publish_to: none
version: 1.0.0+1
environment:
  sdk: '>=3.1.5 <4.0.0'
dependencies:
  flutter:
    sdk: flutter
  flutter_web_plugins:
    sdk: flutter
  cupertino_icons: ^1.0.8
  cupertino_ui: 1.1.2
  material_ui: 1.6.0
  flet: 1.1.2
  serious_python: 6.1.3
  msgpack_dart: ^1.0.1
  path_provider: ^2.1.4
  path: ^1.9.0
  window_manager: ^0.5.1
dependency_overrides:
  flet: 1.1.2
dev_dependencies:
  flutter_lints: ^2.0.0
flutter:
  uses-material-design: true
